<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="header.panel.wrapper">
            <block class="Magento\Framework\View\Element\Template" name="top.customer.castrol.fund"
                   template="Helm_CastrolFund::customer/funds-balance.phtml"
                   ifconfig="castrol_fund/general/enable" after="-" >
                   <arguments>
                        <argument name="view_model" xsi:type="object">Helm\CastrolFund\ViewModel\CastrolFund</argument>
                   </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
