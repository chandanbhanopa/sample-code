<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="catalog_product_save_before">
        <observer name="child_products_observer" instance="Helm\ProductKit\Observer\SaveProductLinkObserver" />
    </event>
    <!-- Add Product to cart-->
    <event name="checkout_cart_product_add_after">
        <observer name="cart_product_add" instance="Helm\ProductKit\Observer\ProductKit\AddChildProductToCart" />
    </event>
    <event name="checkout_cart_remove_item">
        <observer name="cart_product_remove" instance="Helm\ProductKit\Observer\ProductKit\RemoveChildProductFromCart" />
    </event>
</config>